PORT=5000
NODE_ENV=development
TRUST_PROXY_HOPS=0
# Comma-separated frontend origins (e.g. https://sengkoemnan6749-source.github.io,https://your-app.vercel.app)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# For Vercel / serverless deployments without a file, set full serviceAccountKey.json content (raw JSON or base64):
FIREBASE_SERVICE_ACCOUNT_JSON=
ADMIN_EMAILS=admin@techtonic.com

# Strong dedicated cryptographic secrets (generate 64-hex random values for production)
PAYMENT_HMAC_SECRET=
ADMIN_VAULT_SECRET=
DATA_ENCRYPTION_KEY=
TELEGRAM_WEBHOOK_SECRET=

# Telegram & Bakong KHQR
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ORDER_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_ID=
KHQR_PROVIDER=auto
LUYRIEL_API_URL=https://apiaba.lorndavid.online
LUYRIEL_API_KEY=
LUYRIEL_WEBHOOK_SECRET=
LUYRIEL_MERCHANT_LABEL=ABA PayWay KHQR
BAKONG_ACCOUNT_ID=your_id@bkrt
BAKONG_MERCHANT_NAME=Your Store Name
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
BAKONG_TOKEN=
